# ------------------------------------------------------------------
# GregoryAI environment configuration
# Copy this file to .env and fill in the values for your deployment.
# ------------------------------------------------------------------

# --- Domain ---
DOMAIN_NAME=DOMAIN.COM
# Optional: comma-separated extra hostnames/IPs to add to ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS.
# Use for server IPs, legacy domains, or staging hostnames.
# Example: EXTRA_ALLOWED_HOSTS=203.0.113.42,legacy.example.com
EXTRA_ALLOWED_HOSTS=

# --- PostgreSQL ---
POSTGRES_DB="PICK-A-DATABASE-NAME"
POSTGRES_PASSWORD=PICK-A-PASSWORD
POSTGRES_USER=PICK-A-USERNAME

# --- Django ---
# Generate a unique secret key — see https://docs.djangoproject.com/en/4.0/ref/settings/#secret-key
SECRET_KEY=''
# Set to True for local development; leave False (or unset) in production.
DJANGO_DEBUG=False
GREGORY_DIR="<where you cloned the repository>/"

# Encryption key for sensitive database fields (EncryptedTextField).
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_SECRET_KEY=''

# --- Email / SMTP ---
EMAIL_DOMAIN=''
EMAIL_HOST=''
EMAIL_HOST_PASSWORD=''
EMAIL_HOST_USER=''
EMAIL_PORT=587
EMAIL_USE_TLS='True'

# Postmark transactional email service.
# The preferred approach is to set credentials per-team in the Django admin
# (Team → postmark_api_token / postmark_api_url). These env vars are used as
# a fallback when team-level credentials are not configured.
EMAIL_POSTMARK_API_KEY=''
EMAIL_POSTMARK_API_URL='https://api.postmarkapp.com/email'

# Postmark suppression/reactivation webhook (POST /webhooks/). Basic auth
# credentials embedded in the webhook URL configured in Postmark — see
# docs/subscriptions.md#suppression-and-reactivation-webhook. Without these
# set, the endpoint rejects every request with 403 and suppression is only
# ever detected reactively (after a bounced send attempt).
POSTMARK_WEBHOOK_USERNAME=''
POSTMARK_WEBHOOK_PASSWORD=''

# Stats endpoint cache TTL in seconds. Default: 600 (10 minutes).
# Increase for lower DB load; decrease for fresher counts after pipeline runs.
STATS_CACHE_TTL=600

# --- ORCID API ---
# ORCID credentials are no longer configured here.
# Set orcid_client_id and orcid_client_secret per organisation in the Django admin
# under Organisation → OrganizationCredentials.